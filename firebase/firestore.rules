rules_version = '2';

// OzoneGuard AI - Firestore security rules.
// Paste this whole file into: Firebase console > Build > Firestore Database > Rules > Publish.
//
// Data model:  users/{uid}/locations/{locationId} = { name, lat, lon, createdAt }
// Each signed-in user can read, add and delete ONLY their own saved locations.
// Everything else in the database is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/locations/{locationId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lon', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'lat', 'lon', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.lat is number
        && request.resource.data.lat >= 6 && request.resource.data.lat <= 37.6
        && request.resource.data.lon is number
        && request.resource.data.lon >= 68 && request.resource.data.lon <= 97.6
        && request.resource.data.createdAt is number;

      // Saved locations are never edited in place (remove and save again), so no update rule.
    }
  }
}
