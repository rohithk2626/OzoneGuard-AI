APP_VERSION=0.2.0
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# NASA Earthdata bearer token. Keep this ONLY in .env and never commit it.
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_token_here
NASA_CMR_URL=https://cmr.earthdata.nasa.gov/search/granules.umm_json
NASA_SHORT_NAME=OMTO3G
NASA_VERSION=004
NASA_CACHE_DIR=data/raw/nasa
NASA_CACHE_MAX_AGE_HOURS=30

# Firebase / database settings will be added later.
